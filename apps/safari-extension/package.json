{
  "name": "kblock-safari-extension",
  "version": "0.1.0",
  "description": "KBlock Safari Web Extension — ad blocker for Safari on iOS",
  "private": true,
  "scripts": {
    "build": "node scripts/build-filters.mjs && node scripts/build.mjs && node scripts/copy-assets.mjs",
    "build:filters": "node scripts/build-filters.mjs --force",
    "build:check": "tsc --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "*",
    "@types/firefox-webext-browser": "^143.0.1",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "esbuild": "^0.24.0",
    "eslint": "*",
    "globals": "^17.13.0",
    "prettier": "*",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MPL-2.0"
}
