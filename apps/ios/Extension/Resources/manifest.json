{
  "manifest_version": 3,
  "name": "KBlock",
  "version": "0.2.0",
  "description": "Trình chặn quảng cáo Safari miễn phí cho iOS — Ưu tiên website Việt Nam",
  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KBlock"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_rules",
        "enabled": true,
        "path": "rules/base.json"
      },
      {
        "id": "abpvn_rules",
        "enabled": true,
        "path": "rules/abpvn.json"
      },
      {
        "id": "gambling_rules",
        "enabled": true,
        "path": "rules/gambling.json"
      },
      {
        "id": "abpvn_full_rules",
        "enabled": true,
        "path": "rules/generated/abpvn_full.json"
      },
      {
        "id": "easylist_full_rules",
        "enabled": true,
        "path": "rules/generated/easylist_full.json"
      },
      {
        "id": "easyprivacy_full_rules",
        "enabled": true,
        "path": "rules/generated/easyprivacy_full.json"
      },
      {
        "id": "adguard_mobile_rules",
        "enabled": true,
        "path": "rules/generated/adguard_mobile_full.json"
      },
      {
        "id": "adguard_spyware_rules",
        "enabled": true,
        "path": "rules/generated/adguard_spyware_full.json"
      },
      {
        "id": "fanboy_annoyance_rules",
        "enabled": true,
        "path": "rules/generated/fanboy_annoyance_full.json"
      },
      {
        "id": "adguard_urltracking_rules",
        "enabled": true,
        "path": "rules/generated/adguard_urltracking_full.json"
      },
      {
        "id": "removeparam_rules",
        "enabled": true,
        "path": "rules/generated/removeparam_rules.json"
      },
      {
        "id": "betting_guard_rules",
        "enabled": true,
        "path": "rules/betting_guard.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/injected.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.0"
    }
  }
}
