# .gitignore for KBlock

# ────────────────────────────────────────────
# macOS
# ────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ────────────────────────────────────────────
# Xcode
# ────────────────────────────────────────────
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/
.build/

# ────────────────────────────────────────────
# Node.js / npm
# ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
dist/
build/
coverage/
.cache/
*.tsbuildinfo

# ────────────────────────────────────────────
# Environment / Secrets
# ────────────────────────────────────────────
.env
.env.local
.env.*.local
*.p12
*.cer
*.mobileprovision
*.provisionprofile
ExportOptions.plist
AuthKey_*.p8

# ────────────────────────────────────────────
# VS Code
# ────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
# Keep extensions.json for team recommendations
!.vscode/extensions.json

# ────────────────────────────────────────────
# Windows
# ────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ────────────────────────────────────────────
# Filter cache (downloaded at runtime — large files)
# ────────────────────────────────────────────
filters/cache/
filters/*.txt

# ────────────────────────────────────────────
# Test output
# ────────────────────────────────────────────
tests/output/
*.snap

# ────────────────────────────────────────────
# Filter pipeline output (converted from community lists — never committed)
# ────────────────────────────────────────────
apps/safari-extension/.filter-cache/
apps/safari-extension/src/rules/generated/
